# eBPF
ro.bpf.kver_override=5.10.239

# ZRAM
mmd.zram.enabled=true
mmd.zram.size=100%
mmd.zram.comp_algorithm=lzo-rle
mmd.zram.writeback.enabled=true
mmd.zram.writeback.huge_idle.enabled=false
mmd.zram.writeback.device_size=1073741824
mmd.zram.writeback.min_idle_seconds=0
mmd.zram.writeback.max_idle_seconds=86400
mmd.zram.writeback.use_nr_tags_prop=true
mmd.zram.writeback.nr_tags=32
mm.zram.maintenance.first_delay_seconds=86400
mm.zram.maintenance.periodic_delay_seconds=86400
